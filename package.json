{
  "name": "mcp-pr-review-optimizer",
  "version": "1.0.0",
  "description": "MCP server to optimize pull request review process with intelligent reviewer suggestions and bottleneck analysis",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "redeploy": "npm run build && npm start",
    "clean": "rm -rf dist"
  },
  "keywords": [
